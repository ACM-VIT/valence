{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Valence problem.yaml (package format v0)",
  "description": "See docs/problem-format.md. Limits mirror the CHECK constraints on the problems table.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "slug", "title"],
  "properties": {
    "version": {
      "const": 0
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "time_limit_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 20000,
      "default": 1000
    },
    "memory_limit_mb": {
      "type": "integer",
      "minimum": 16,
      "maximum": 2048,
      "default": 256
    },
    "checker": {
      "type": "string",
      "pattern": "^(exact|tokens|float:[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?)$",
      "default": "tokens"
    },
    "samples": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true,
      "default": []
    }
  }
}
